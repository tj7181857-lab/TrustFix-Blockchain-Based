# ─── TrustTix Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it contains private keys.

# ── Blockchain ────────────────────────────────────────────────────────────────

# RPC URL of the Hardhat local node (default: http://127.0.0.1:8545)
RPC_URL=http://127.0.0.1:8545

# Optional override for the multi-event contract address.
# Normally deployment-multi-event.json is the source of truth.
MULTI_EVENT_CONTRACT_ADDRESS=

# Optional beginning block for tracing wallet activity.
ORIGIN_SCAN_START_BLOCK=0

# Legacy single-event settings; not used by the current multi-event backend.
CONTRACT_ADDRESS=
ORGANIZER_PRIVATE_KEY=

# ── Backend server ────────────────────────────────────────────────────────────

# Port the backend listens on (default: 3001)
PORT=3001

# ── Sepolia testnet (optional — only needed to redeploy to Sepolia) ───────────

# Get a free RPC URL from Alchemy (https://www.alchemy.com) or Infura
SEPOLIA_RPC_URL=

# Sepolia wallet private key — must have Sepolia ETH from a faucet
# https://sepoliafaucet.com
# PRIVATE_KEY=
